# Ghostty terminal config
# https://ghostty.org/docs/config

# Per-machine font: set GHOSTTY_FONT_FAMILY in ~/.config/secrets/*.fish (it is
# read when `chezmoi apply` renders this template; falls back to Maple Mono NF).
font-family = {{ env "GHOSTTY_FONT_FAMILY" | default "Maple Mono NF" }}
font-size = 13
minimum-contrast = 4.5
shell-integration = fish
theme = dark:warm-burnout-dark,light:warm-burnout-light
# theme = dark:Flexoki Dark,light:Flexoki Light
window-padding-x = 10
window-save-state = always

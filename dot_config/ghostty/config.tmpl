# Ghostty terminal config
# https://ghostty.org/docs/config

# Machine-local overrides (font etc.) live in ~/.config/secrets/ghostty.conf
# (untracked, created per machine — see ~/.config/secrets/README.md).
# config-file keys are processed at the end and override everything above;
# the ? prefix ignores the file when it doesn't exist.
config-file = ?{{ .chezmoi.homeDir }}/.config/secrets/ghostty.conf

font-family = Maple Mono NF
font-size = 13
minimum-contrast = 4.5
shell-integration = fish
theme = dark:warm-burnout-dark,light:warm-burnout-light
# theme = dark:Flexoki Dark,light:Flexoki Light
window-padding-x = 10
window-save-state = always
